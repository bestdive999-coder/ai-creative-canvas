PORT=5173
ADMIN_PORT=5188
ECOM_EMPLOYEE_HOST=127.0.0.1
ECOM_ADMIN_HOST=127.0.0.1

# 反向代理终止 HTTPS 时才设为 1，并同时限制可信代理来源。
ECOM_TRUST_PROXY=0
ECOM_COOKIE_SECURE=0

# 默认关闭远程下载安装；优先使用网页上传且已核对 SHA-256 的本机包。
ECOM_ALLOW_REMOTE_UPDATE=0
ECOM_ALLOW_REMOTE_RUNTIME_DOWNLOAD=0

# 可选：32 字节 Base64 或 64 位十六进制。留空时会在 runtime/intranet/
# 自动生成 secret-key.bin；备份和恢复时必须把该文件与配置、账户库一起保存。
ECOM_CONFIG_SECRET_KEY=

TEXT_SERVICE_A_API_KEY=
TEXT_SERVICE_B_API_KEY=
PRIMARY_IMAGE_API_KEY=
SECONDARY_IMAGE_API_KEY=
REMOTE_IMAGE_STORAGE_TOKEN=
REMOTE_IMAGE_STORAGE_API_BASE_URL=
REMOTE_IMAGE_STORAGE_RAW_BASE_URL=

# 可接入任意兼容相应协议的服务；不预置供应商地址。
PRIMARY_IMAGE_API_BASE_URL=
PRIMARY_IMAGE_AUTH_HEADER=authorization
PRIMARY_IMAGE_AUTH_PREFIX=Bearer
SECONDARY_IMAGE_API_BASE_URL=
TEXT_SERVICE_A_BASE_URL=
TEXT_SERVICE_A_AUTH_HEADER=authorization
TEXT_SERVICE_A_AUTH_PREFIX=Bearer
TEXT_SERVICE_B_BASE_URL=
TEXT_SERVICE_C_BASE_URL=

PRIMARY_IMAGE_MODEL=
PRIMARY_IMAGE_EDIT_MODEL=
PRIMARY_REASONING_MODEL=
PRIMARY_DEEP_REASONING_MODEL=
SECONDARY_IMAGE_MODEL=

AI_IMAGE_MAX_CONCURRENCY=2
AI_IMAGE_MAX_QUEUE=24
